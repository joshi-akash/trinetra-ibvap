[Unit]
Description=TRINETRA AI-CCTV Edge Surveillance Stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/trinetra
ExecStart=/usr/bin/docker compose -f /opt/trinetra/docker-compose.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f /opt/trinetra/docker-compose.yml down
TimeoutStartSec=0
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
